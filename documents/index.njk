---
layout: base.njk
title: Documents
permalink: /documents/index.html
---

<section class="page-header">
  <div class="container">
    <h1>Documents &amp; Records</h1>
    <p>
      Records released in response to public records requests, organized by request ID. Each
      request folder lists all documents produced, with metadata for each file.
    </p>
  </div>
</section>

<div class="container">

  {% set folders = collections.requestFolder %}

  {% if not folders or folders.length == 0 %}
  <div class="empty-state">
    <p>
      No records have been released yet. Requests were filed September 9, 2026.
      Under Neb. Rev. Stat. § 84-712.01, agencies must respond within four business days.
    </p>
  </div>
  {% else %}

  <div class="section-header">
    <h2>Request Files</h2>
    <span class="count">{{ folders | length }}</span>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Agency</th>
          <th>Filed</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% for folder in folders | sort(false, false, "data.requestId") %}
        <tr>
          <td class="id-cell">
            <a href="{{ folder.url }}">{{ folder.data.requestId }}</a>
          </td>
          <td class="agency-name">{{ folder.data.agency }}</td>
          <td class="date-cell">{{ folder.data.dateFiled | dateDisplay }}</td>
          <td>
            <span class="badge badge-{{ folder.data.status | statusClass }}">{{ folder.data.status }}</span>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% endif %}

</div>
