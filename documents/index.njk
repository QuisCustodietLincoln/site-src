---
layout: base.njk
title: Documents & Records
permalink: /documents/index.html
---

<section class="page-header">
  <div class="container">
    <h1>Released Records</h1>
    <p>
      Documents and records released in response to public records requests are published here
      as they are received. Files are hosted in this repository for permanent public access.
    </p>
  </div>
</section>

<div class="container">

{% if documents.length == 0 %}
  <div class="empty-state">
    <p>
      No records have been released yet. Requests were filed September 9, 2026.
      Responses are due within 4 business days under Neb. Rev. Stat. § 84-712.01.
    </p>
  </div>
{% else %}
  <div class="section-header">
    <h2>Released Records</h2>
    <span class="count">{{ documents | length }} documents</span>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Agency</th>
          <th>Document</th>
          <th>Type</th>
          <th>Date Received</th>
          <th>File</th>
        </tr>
      </thead>
      <tbody>
        {% for doc in documents %}
        <tr>
          <td>
            <div class="agency-name">{{ doc.agency }}</div>
          </td>
          <td>{{ doc.title }}</td>
          <td>{{ doc.type }}</td>
          <td class="date-cell">{{ doc.dateReceived | dateDisplay }}</td>
          <td>
            <a class="ext-link" href="{{ doc.fileUrl }}" target="_blank" rel="noopener">
              View ↗
            </a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}

</div>
