---
layout: base.njk
title: Public Records Tracker
---

<section class="hero">
  <div class="container">
    <p class="hero-eyebrow">Nebraska ALPR Transparency Project</p>
    <h1>Quis Custodiet Lincoln</h1>
    <p>
      A public interest project tracking requests filed under the Nebraska Public Records Act
      to document how local and state agencies in Lincoln, Nebraska acquire, operate, and oversee
      automated license plate reader (ALPR) systems. Request materials, agency responses, and
      released records are published here as they are received.
    </p>
  </div>
</section>

<div class="container">
  <div class="section-header">
    <h2>Requests Filed</h2>
    <span class="count">{{ requests | length }} requests</span>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Agency</th>
          <th>Filed</th>
          <th>Status</th>
          <th>MuckRock</th>
        </tr>
      </thead>
      <tbody>
        {% for req in requests %}
        <tr>
          <td>
            <div class="agency-name">{{ req.agency }}</div>
            <div class="agency-meta">{{ req.agencyType }} &middot; {{ req.jurisdiction }}</div>
          </td>
          <td class="date-cell">{{ req.dateFiled | dateDisplay }}</td>
          <td>
            <span class="badge badge-{{ req.status | statusClass }}">{{ req.status }}</span>
          </td>
          <td>
            {% if req.muckrockUrl %}
              <a class="ext-link" href="{{ req.muckrockUrl }}" target="_blank" rel="noopener">
                View request ↗
              </a>
            {% else %}
              <span class="link-none">—</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
